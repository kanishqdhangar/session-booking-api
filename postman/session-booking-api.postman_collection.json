{
  "info": {
    "name": "Session Booking API",
    "description": "Postman v2.1 collection for the Session Booking API assignment. Run requests in order in the Main Workflow folder. The collection stores IDs in collection variables.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000"
    },
    {
      "key": "userId",
      "value": ""
    },
    {
      "key": "teacherId",
      "value": ""
    },
    {
      "key": "sessionId",
      "value": ""
    },
    {
      "key": "dateTimestamp",
      "value": ""
    },
    {
      "key": "userEmail",
      "value": ""
    },
    {
      "key": "sessionStartTime",
      "value": ""
    },
    {
      "key": "sessionEndTime",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Main Workflow",
      "item": [
        {
          "name": "Create Teacher",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/teachers",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "teachers"
              ]
            },
            "description": "Creates a teacher and saves teacherId for later requests.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fullName\": \"Postman Test Teacher\",\n  \"email\": \"postman-teacher-{{$timestamp}}@example.com\",\n  \"specialization\": \"Backend Engineering\",\n  \"experience\": 5\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Returns 201 Created', function () { pm.response.to.have.status(201); });",
                  "const body = pm.response.json();",
                  "pm.test('Returns created teacher data', function () { pm.expect(body.success).to.eql(true); pm.expect(body.data).to.be.an('object'); });",
                  "if (body.data && body.data._id) pm.collectionVariables.set('teacherId', body.data._id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Create User",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/users",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "users"
              ]
            },
            "description": "Creates a user and saves userId.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fullName\": \"Postman Test User\",\n  \"email\": \"{{userEmail}}\",\n  \"phone\": \"+15551234567\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set('userEmail', `postman-user-${Date.now()}@example.com`);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Returns 201 Created', function () { pm.response.to.have.status(201); });",
                  "const body = pm.response.json();",
                  "pm.test('Returns created user data', function () { pm.expect(body.success).to.eql(true); pm.expect(body.data).to.be.an('object'); });",
                  "if (body.data && body.data._id) pm.collectionVariables.set('userId', body.data._id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Create Session",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/sessions",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "sessions"
              ]
            },
            "description": "Creates a session. Before sending, set startTime and endTime to valid ISO timestamps with endTime after startTime. Saves sessionId and dateTimestamp from startTime.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"teacherId\": \"{{teacherId}}\",\n  \"startTime\": \"{{sessionStartTime}}\",\n  \"endTime\": \"{{sessionEndTime}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const start = new Date(Date.now() + 24 * 60 * 60 * 1000);",
                  "start.setUTCMinutes(0, 0, 0);",
                  "pm.collectionVariables.set('sessionStartTime', start.toISOString());",
                  "pm.collectionVariables.set('sessionEndTime', new Date(start.getTime() + 60 * 60 * 1000).toISOString());"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Returns 201 Created', function () { pm.response.to.have.status(201); });",
                  "const body = pm.response.json();",
                  "pm.test('Returns created session data', function () { pm.expect(body.success).to.eql(true); pm.expect(body.data).to.be.an('object'); });",
                  "if (body.data && body.data._id) pm.collectionVariables.set('sessionId', body.data._id);",
                  "if (body.data && body.data.startTime) pm.collectionVariables.set('dateTimestamp', String(new Date(body.data.startTime).getTime()));"
                ]
              }
            }
          ]
        },
        {
          "name": "Get Available Sessions",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/sessions/available?dateTimestamp={{dateTimestamp}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "sessions",
                "available"
              ],
              "query": [
                {
                  "key": "dateTimestamp",
                  "value": "{{dateTimestamp}}"
                }
              ]
            },
            "description": "Returns available sessions for the UTC day containing dateTimestamp."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Returns 200 OK', function () { pm.response.to.have.status(200); });",
                  "const body = pm.response.json();",
                  "pm.test('Returns success and data array', function () { pm.expect(body.success).to.eql(true); pm.expect(body.data).to.be.an('array'); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Book Session",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/sessions/{{sessionId}}/book",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "sessions",
                "{{sessionId}}",
                "book"
              ]
            },
            "description": "Books the created session for the created user.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"userId\": \"{{userId}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Returns 200 OK', function () { pm.response.to.have.status(200); });",
                  "pm.test('Booking succeeds', function () { pm.expect(pm.response.json().success).to.eql(true); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Book Session Again",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/sessions/{{sessionId}}/book",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "sessions",
                "{{sessionId}}",
                "book"
              ]
            },
            "description": "Expected conflict: a session that is already booked cannot be booked again.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"userId\": \"{{userId}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Returns 409 Conflict', function () { pm.response.to.have.status(409); });",
                  "pm.test('Returns error response', function () { pm.expect(pm.response.json().success).to.eql(false); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Get User Sessions Before Complete",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/users/{{userId}}/sessions",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "users",
                "{{userId}}",
                "sessions"
              ]
            },
            "description": "Verifies the booked session appears under upcomingSessions."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Returns 200 OK', function () { pm.response.to.have.status(200); });",
                  "const body = pm.response.json();",
                  "pm.test('Booked session is upcoming', function () { pm.expect(body.data.upcomingSessions).to.be.an('array'); pm.expect(body.data.upcomingSessions.some(s => s._id === pm.collectionVariables.get('sessionId'))).to.eql(true); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Complete Session",
          "request": {
            "method": "PATCH",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/sessions/{{sessionId}}/complete",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "sessions",
                "{{sessionId}}",
                "complete"
              ]
            },
            "description": "Marks the booked session completed."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Returns 200 OK', function () { pm.response.to.have.status(200); });",
                  "pm.test('Completion succeeds', function () { pm.expect(pm.response.json().success).to.eql(true); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Complete Session Again",
          "request": {
            "method": "PATCH",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/sessions/{{sessionId}}/complete",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "sessions",
                "{{sessionId}}",
                "complete"
              ]
            },
            "description": "Expected conflict: only BOOKED sessions can be completed."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Returns 409 Conflict', function () { pm.response.to.have.status(409); });",
                  "pm.test('Returns error response', function () { pm.expect(pm.response.json().success).to.eql(false); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Get User Sessions After Complete",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/users/{{userId}}/sessions",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "users",
                "{{userId}}",
                "sessions"
              ]
            },
            "description": "Verifies the completed session appears under completedSessions."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Returns 200 OK', function () { pm.response.to.have.status(200); });",
                  "const body = pm.response.json();",
                  "pm.test('Session is completed', function () { pm.expect(body.data.completedSessions).to.be.an('array'); pm.expect(body.data.completedSessions.some(s => s._id === pm.collectionVariables.get('sessionId'))).to.eql(true); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Health Check",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/health",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "health"
              ]
            },
            "description": "Checks API and database connectivity."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Returns 200 OK', function () { pm.response.to.have.status(200); });",
                  "const body = pm.response.json();",
                  "pm.test('Database is connected', function () { pm.expect(body.data.database).to.eql('connected'); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Get Available Sessions Paginated",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/sessions/available?dateTimestamp={{dateTimestamp}}&page=1&limit=10",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "sessions",
                "available"
              ],
              "query": [
                {
                  "key": "dateTimestamp",
                  "value": "{{dateTimestamp}}"
                },
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "limit",
                  "value": "10"
                }
              ]
            },
            "description": "Verifies opt-in pagination metadata."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Returns 200 OK', function () { pm.response.to.have.status(200); });",
                  "const body = pm.response.json();",
                  "pm.test('Returns pagination metadata', function () { pm.expect(body.data).to.be.an('array'); pm.expect(body.meta.page).to.eql(1); pm.expect(body.meta.limit).to.eql(10); pm.expect(body.meta.total).to.be.a('number'); pm.expect(body.meta.totalPages).to.be.a('number'); });"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Error Cases",
      "item": [
        {
          "name": "Duplicate User Email",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/users",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "users"
              ]
            },
            "description": "Run after the Main Workflow has created the user. Reuses the saved userEmail and should return 409.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fullName\": \"Duplicate User\",\n  \"email\": \"{{userEmail}}\",\n  \"phone\": \"+15551234567\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Returns 409 Conflict for duplicate email', function () { pm.response.to.have.status(409); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Invalid Session Time Range",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/sessions",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "sessions"
              ]
            },
            "description": "Expected validation failure when endTime is not after startTime.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"teacherId\": \"{{teacherId}}\",\n  \"startTime\": \"2026-10-20T12:00:00.000Z\",\n  \"endTime\": \"2026-10-20T11:00:00.000Z\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Returns 400 Bad Request', function () { pm.response.to.have.status(400); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Unknown Teacher ID",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/sessions",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "sessions"
              ]
            },
            "description": "Expected 404 when the referenced teacher does not exist.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"teacherId\": \"507f1f77bcf86cd799439011\",\n  \"startTime\": \"2026-10-20T10:00:00.000Z\",\n  \"endTime\": \"2026-10-20T11:00:00.000Z\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Returns 404 Not Found', function () { pm.response.to.have.status(404); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Available Sessions Missing Timestamp",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/sessions/available",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "sessions",
                "available"
              ]
            },
            "description": "Expected validation failure when required dateTimestamp is omitted."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Returns 400 Bad Request', function () { pm.response.to.have.status(400); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Invalid Session ObjectId",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/sessions/abc/book",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "sessions",
                "abc",
                "book"
              ]
            },
            "description": "Expected 400 for an invalid session ID.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"userId\": \"{{userId}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Returns 400 Bad Request', function () { pm.response.to.have.status(400); });"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}